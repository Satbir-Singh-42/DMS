@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
    <div>
        <h4 class="mb-0 fw-bold">Dashboard</h4>
        <span class="text-muted small">Welcome back, <strong>@Model.EmployeeName</strong> (Role: <span class="badge bg-secondary">@Model.Role</span>)</span>
    </div>
    <div class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMM yyyy")
    </div>
</div>

@if (Model.Role == "QA")
{
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card border-start border-4 border-warning h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Pending Reviews</span>
                            <h2 class="fw-bold my-2 text-warning">@Model.PendingReviews</h2>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                            <i class="bi bi-search fs-4"></i>
                        </div>
                    </div>
                    <a href="/Review" class="stretched-link text-decoration-none small fw-semibold text-warning d-flex align-items-center gap-1">
                        Go to reviews <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card border-start border-4 border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Pending Approvals</span>
                            <h2 class="fw-bold my-2 text-primary">@Model.PendingApprovals</h2>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-check2-circle fs-4"></i>
                        </div>
                    </div>
                    <a href="/Approval" class="stretched-link text-decoration-none small fw-semibold text-primary d-flex align-items-center gap-1">
                        Review &amp; approve <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card border-start border-4 border-info h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Access Requests</span>
                            <h2 class="fw-bold my-2 text-info">@Model.PendingAccessRequests</h2>
                        </div>
                        <div class="bg-info-subtle text-info p-3 rounded-circle">
                            <i class="bi bi-key fs-4"></i>
                        </div>
                    </div>
                    <a href="/AccessRequest" class="stretched-link text-decoration-none small fw-semibold text-info d-flex align-items-center gap-1">
                        View requests <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card border-start border-4 border-success h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Pending Issuance</span>
                            <h2 class="fw-bold my-2 text-success">@Model.PendingIssuance</h2>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle">
                            <i class="bi bi-send-check fs-4"></i>
                        </div>
                    </div>
                    <a href="/Issue" class="stretched-link text-decoration-none small fw-semibold text-success d-flex align-items-center gap-1">
                        Issue documents <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-2">Quick Actions</h5>
                <p class="text-muted small mb-3">Common tasks for QA document control officers:</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/Upload" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Upload &amp; Verify Document
                    </a>
                    <a href="/Document" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-folder2-open me-1"></i> Browse Document Master
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Role == "Plant")
{
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card stat-card border-start border-4 border-warning h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">My Pending Requests</span>
                            <h2 class="fw-bold my-2 text-warning">@Model.MyPendingRequests</h2>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                    <a href="/AccessRequest" class="stretched-link text-decoration-none small fw-semibold text-warning d-flex align-items-center gap-1">
                        Check status <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card stat-card border-start border-4 border-success h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Approved Grants</span>
                            <h2 class="fw-bold my-2 text-success">@Model.MyApprovedRequests</h2>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle">
                            <i class="bi bi-file-earmark-check fs-4"></i>
                        </div>
                    </div>
                    <a href="/AccessRequest" class="stretched-link text-decoration-none small fw-semibold text-success d-flex align-items-center gap-1">
                        View documents now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-12 col-xl-4">
            <div class="card stat-card border-start border-4 border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Document Master</span>
                            <h5 class="fw-bold my-2 text-primary">Browse &amp; Request</h5>
                            <p class="small text-muted mb-0">Search active plant procedures and drawings</p>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-search fs-4"></i>
                        </div>
                    </div>
                    <a href="/Document" class="stretched-link text-decoration-none small fw-semibold text-primary d-flex align-items-center gap-1 mt-2">
                        Open master catalog <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Role == "Admin")
{
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card stat-card border-start border-4 border-primary h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Total Users</span>
                            <h2 class="fw-bold my-2 text-primary">@Model.TotalUsers</h2>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-check-circle me-1"></i>@Model.ActiveUsers Active Accounts
                            </span>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                    <a href="/User" class="stretched-link mt-3 d-block text-decoration-none small fw-semibold text-primary">
                        Manage user accounts <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card stat-card border-start border-4 border-success h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Controlled Documents</span>
                            <h2 class="fw-bold my-2 text-success">@Model.TotalDocuments</h2>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                In System
                            </span>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle">
                            <i class="bi bi-file-earmark-lock fs-4"></i>
                        </div>
                    </div>
                    <a href="/Document" class="stretched-link mt-3 d-block text-decoration-none small fw-semibold text-success">
                        Inspect document master <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
