@{
    ViewData["Title"] = "Authorized Document Viewer";
    var isQa = ViewBag.IsQa == true;
    var requestId = ViewBag.RequestId;
    var revisionId = ViewBag.RevisionId;
    var expiresAt = ViewBag.ExpiresAt;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
            <span>Authorized Document Viewer</span>
        </h4>
        <small class="text-muted">
            @(isQa ? "QA Authorized Inspection View" : "One-Time Authorized Viewing Session")
        </small>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (expiresAt != null)
        {
            <div class="badge bg-warning-subtle text-warning border border-warning-subtle py-2 px-3">
                <i class="bi bi-stopwatch me-1"></i> Session Expires: @(((DateTime)expiresAt).ToString("HH:mm:ss UTC"))
            </div>
        }
        <a href="/Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-box-arrow-left me-1"></i> Exit Viewer
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white py-2 px-3 small d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-shield-fill-check text-success me-1"></i> Secure Delivery &bull; Server Token Verified
        </span>
        <span class="text-secondary small">Controlled Intranet Viewer</span>
    </div>
    <div class="card-body p-0" style="min-height: 75vh; height: calc(100vh - 210px); background-color: #525659;">
        @if (isQa && revisionId != null)
        {
            <iframe src="/Viewer/ServePdf?revisionId=@revisionId" class="w-100 h-100 border-0" title="PDF Document Viewer">
                <p>Your browser does not support embedded PDF viewing. Please contact your IT administrator.</p>
            </iframe>
        }
        else if (requestId != null)
        {
            <iframe src="/Viewer/ServePdf?requestId=@requestId" class="w-100 h-100 border-0" title="PDF Document Viewer">
                <p>Your browser does not support embedded PDF viewing. Please contact your IT administrator.</p>
            </iframe>
        }
        else
        {
            <div class="text-center text-white p-5">
                <i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-3"></i>
                <h5>Viewing Session Unavailable</h5>
                <p class="text-white-50">Invalid session grant or the session has expired.</p>
                <a href="/Dashboard" class="btn btn-outline-light btn-sm mt-2">Return to Dashboard</a>
            </div>
        }
    </div>
</div>
