@model ErrorViewModel
@{
    ViewData["Title"] = "System Error";
    var statusCode = ViewBag.StatusCode ?? 500;
    var message = ViewBag.StatusMessage as string ?? "An unexpected error occurred while processing your request.";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="mb-3 text-warning">
                    @if (statusCode == 404)
                    {
                        <i class="bi bi-question-circle display-1 text-secondary"></i>
                    }
                    else if (statusCode == 403)
                    {
                        <i class="bi bi-shield-slash display-1 text-danger"></i>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
                    }
                </div>

                <h1 class="h3 fw-bold mb-2">Error @statusCode</h1>
                <p class="text-muted mb-4">@message</p>

                @if (Model.ShowRequestId)
                {
                    <div class="bg-light p-2 rounded small text-muted mb-4 text-start font-monospace">
                        <span class="fw-semibold">Tracking Request ID:</span> @Model.RequestId
                    </div>
                }

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="/Dashboard" class="btn btn-primary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-house-door"></i> Return to Dashboard
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> Go Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
