@model LoginViewModel
@{
    ViewData["Title"] = "Employee Login";
}

<div class="row justify-content-center align-items-center" style="min-height: calc(85vh - 70px);">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header text-center py-4 text-white border-0" style="background: linear-gradient(135deg, #1e3a8a, #0f172a);">
                <div class="mb-2">
                    <i class="bi bi-shield-lock-fill fs-1 text-info"></i>
                </div>
                <h4 class="fw-bold mb-1">DMS Intranet</h4>
                <p class="small text-light opacity-75 mb-0">Controlled Document Management System</p>
            </div>
            <div class="card-body p-4 p-sm-5">
                <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SalaryCode" class="form-label small fw-semibold text-muted">Salary Code</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="SalaryCode" class="form-control font-monospace" placeholder="e.g. ADMIN001" required autofocus />
                        </div>
                        <span asp-validation-for="SalaryCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small fw-semibold text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Enter password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In to DMS
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-top small text-muted">
                <i class="bi bi-lock me-1"></i> Intranet Access Only &bull; Monitored &amp; Audited
            </div>
        </div>
    </div>
</div>
