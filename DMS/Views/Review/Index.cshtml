@model ReviewListViewModel
@{
    ViewData["Title"] = "Review Documents";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold">Pending Reviews</h4>
        <small class="text-muted">First-stage QA review for newly uploaded revisions</small>
    </div>
    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
        <i class="bi bi-clock-history me-1"></i> @Model.PendingRevisions.Count Item(s) Pending
    </span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Serial No.</th>
                    <th scope="col">Document Name</th>
                    <th scope="col">Plant</th>
                    <th scope="col">Revision</th>
                    <th scope="col">Uploaded By</th>
                    <th scope="col">Uploaded At</th>
                    <th scope="col" class="text-end">Review Decision</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PendingRevisions.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-check2-all fs-1 text-success d-block mb-2"></i>
                            <div>All uploaded revisions have been reviewed. No pending tasks!</div>
                        </td>
                    </tr>
                }
                @foreach (var rev in Model.PendingRevisions)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">@rev.SerialNumber</span></td>
                        <td class="fw-semibold text-dark">@rev.DocumentName</td>
                        <td><span class="badge bg-secondary-subtle text-dark border">@rev.Plant</span></td>
                        <td><span class="badge bg-info-subtle text-info border border-info-subtle font-monospace">Rev @rev.RevisionNumber</span></td>
                        <td><small class="text-muted">@rev.UploadedByName</small></td>
                        <td><small class="text-muted">@rev.UploadedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <form method="post" asp-action="Submit" class="d-inline">
                                    <input type="hidden" name="RevisionID" value="@rev.RevisionID" />
                                    <input type="hidden" name="Decision" value="Approved" />
                                    <button type="submit" class="btn btn-outline-success" onclick="return confirm('Promote this revision to Document Approval stage?')">
                                        <i class="bi bi-check-lg"></i> Pass Review
                                    </button>
                                </form>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@rev.RevisionID">
                                    <i class="bi bi-x-lg"></i> Reject
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Rejection Modals rendered cleanly outside table -->
@foreach (var rev in Model.PendingRevisions)
{
    <div class="modal fade" id="rejectModal-@rev.RevisionID" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="Submit">
                    <input type="hidden" name="RevisionID" value="@rev.RevisionID" />
                    <input type="hidden" name="Decision" value="Rejected" />
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-x-octagon me-1"></i> Reject Revision Review</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Rejecting Revision <strong>@rev.RevisionNumber</strong> for document <strong>@rev.DocumentName</strong>.</p>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea name="Remarks" class="form-control" rows="3" placeholder="Specify corrections or issues found..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-danger">Confirm Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
