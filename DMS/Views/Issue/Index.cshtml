@model ReviewListViewModel
@{
    ViewData["Title"] = "Issue Documents";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold">Document Issuance Register</h4>
        <small class="text-muted">Record official controlled release/issuance for active documents per company standards</small>
    </div>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
        <i class="bi bi-send-check me-1"></i> @Model.PendingRevisions.Count Awaiting Issuance
    </span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Serial No.</th>
                    <th scope="col">Document Name</th>
                    <th scope="col">Plant</th>
                    <th scope="col">Revision</th>
                    <th scope="col">Uploader</th>
                    <th scope="col" class="text-end">Issuance Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PendingRevisions.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                            <div>All active documents are up-to-date in the issuance register.</div>
                        </td>
                    </tr>
                }
                @foreach (var rev in Model.PendingRevisions)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">@rev.SerialNumber</span></td>
                        <td class="fw-semibold text-dark">@rev.DocumentName</td>
                        <td><span class="badge bg-secondary-subtle text-dark border">@rev.Plant</span></td>
                        <td><span class="badge bg-info-subtle text-info border border-info-subtle font-monospace">Rev @rev.RevisionNumber</span></td>
                        <td><small class="text-muted">@rev.UploadedByName</small></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#issueModal-@rev.RevisionID">
                                <i class="bi bi-send-check me-1"></i> Record Issue
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Issuance Modals rendered cleanly outside table -->
@foreach (var rev in Model.PendingRevisions)
{
    <div class="modal fade" id="issueModal-@rev.RevisionID" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="Submit">
                    <input type="hidden" name="revisionId" value="@rev.RevisionID" />
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fs-6 fw-bold">
                            <i class="bi bi-shield-lock me-1"></i> Authorize Document Release
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">
                            Issuing official controlled release for <strong>@rev.DocumentName</strong> (Rev <code>@rev.RevisionNumber</code>).
                        </p>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">QA Password Re-verification <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" placeholder="Re-enter your account password" required autofocus />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Issuance Details / Remarks (Optional)</label>
                            <textarea name="remarks" class="form-control form-control-sm" rows="3" placeholder="e.g. Distributed electronic master; issued copy #01 to Plant QA file"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-send-check me-1"></i> Confirm &amp; Issue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
